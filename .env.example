# Required for auth + database-backed user/session flows
DATABASE_URL="******HOST:5432/interdisciplinary_collab"
# Direct (non-pooled) connection used by migrations. Same as DATABASE_URL locally;
# on Neon, DATABASE_URL is the "-pooler" string and DIRECT_URL the one without it.
DIRECT_URL="******HOST:5432/interdisciplinary_collab"
AUTH_SECRET="replace-with-a-generated-secret"
AUTH_URL="http://localhost:3000"

# Email (sign-up verification). In local development these can be left unset: the
# verification link is printed in the server log and shown on screen instead.
# In production sign-up refuses to run without them.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
EMAIL_FROM="Collab Commons <no-reply@your-college.edu>"
